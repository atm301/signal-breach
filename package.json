{
  "name": "signal-breach",
  "version": "0.3.0",
  "description": "Signal Breach 訊號突破 — 5x5 科幻回合制戰棋 Roguelike（純前端，可靜態部署）",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node serve.mjs",
    "sim": "node tools/simulate.mjs",
    "sim:max": "node tools/simulate.mjs --meta=max",
    "sim:long": "node tools/simulate.mjs --runs=2000",
    "test": "node tests/full-flow-test.mjs",
    "check": "npm run sim && npm run test && npm run check:audio && npm run check:tactics && npm run check:tutorial",
    "shots": "node tools/shots.mjs",
    "assets": "node tools/slice-sheets.mjs && node tools/make-og.mjs",
    "assets:review": "node tools/asset-contact-sheet.mjs",
    "check:subpath": "node tools/check-subpath.mjs",
    "check:live": "node tools/check-live.mjs",
    "check:audio": "node tools/check-audio.mjs",
    "check:pacing": "node tools/check-pacing.mjs",
    "check:tactics": "node tools/check-tactics.mjs",
    "check:tutorial": "node tools/check-tutorial.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "homepage": "https://atm301.github.io/signal-breach/",
  "repository": {
    "type": "git",
    "url": "https://github.com/atm301/signal-breach.git"
  }
}
